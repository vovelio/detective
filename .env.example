# Local loopback development only; generate a disposable TOKEN_HASH_PEPPER (>=32 bytes).
# Production Docker/HTTPS uses .env.production.example and infra/ops.py secret files.
# This file remains for the existing native loopback development server.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://detective_local@127.0.0.1:55440/detective_local
TOKEN_HASH_PEPPER=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:8000
SESSION_COOKIE_SECURE=false
CASE_STORAGE_PATH=.local/cases
DATABASE_SCHEMA=public
